        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 0.5,
        "topic": "lab2/dusov/function",
        "payload": "{\"student\": \"Дусов СПД ИИ-241\", \"readings\": [21.5, 24.0, 27.3, 26.1, 23.8]}",
        "payloadType": "json",
        "x": 200,
