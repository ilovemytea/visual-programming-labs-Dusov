        "z": "t00000000000a",
        "name": "Статистика показаний",
        "func": "// Анализ показаний датчиков (код сгенерирован с помощью AI и проверен вручную)\n// Вход: msg.payload = { student, readings: [числа] }\nconst input = msg.payload || {};\nconst readings = Array.isArray(input.readings) ? input.readings : [];\nconst threshold = 25;            // порог «высокой» температуры, °C\n\nlet sum = 0;\nlet max = -Infinity;\nlet min = Infinity;\nconst above = [];                // массив значений выше порога\n\nfor (let i = 0; i < readings.length; i++) {\n    const value = Number(readings[i]);\n    sum += value;\n    if (value > max) max = value;\n    if (value < min) min = value;\n    if (value > threshold) {\n        above.push(value);\n    }\n}\n\nconst avg = readings.length > 0 ? sum / readings.length : 0;\n\nlet status;\nif (readings.length === 0) {\n    status = \"empty\";\n} else if (avg > threshold) {\n    status = \"high\";\n} else {\n    status = \"normal\";\n}\n\n// Результат — объект\nconst result = {\n    student: input.student || \"unknown\",\n    count: readings.length,\n    avg: Number(avg.toFixed(2)),\n    min: readings.length ? min : null,\n    max: readings.length ? max : null,\n    aboveThreshold: above,\n    status: status\n};\n\nmsg.topic = \"lab2/dusov/function\";\nmsg.payload = result;\nreturn msg;",
