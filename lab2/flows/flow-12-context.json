    {
        "id": "f000000000052",
        "type": "function",
        "z": "t000000000050",
        "name": "Счётчик во flow context",
        "func": "// Счётчик живёт между сообщениями в flow context\nif (msg.topic === \"reset\") {\n    flow.set(\"dusovCounter\", 0);\n    flow.set(\"dusovHistory\", []);\n    msg.payload = { action: \"reset\", counter: 0 };\n    return msg;\n}\nconst counter = (flow.get(\"dusovCounter\") || 0) + 1;\nconst history = flow.get(\"dusovHistory\") || [];\nhistory.push(new Date().toLocaleTimeString(\"ru-RU\"));\nif (history.length > 5) history.shift();      // храним 5 последних отметок\nflow.set(\"dusovCounter\", counter);\nflow.set(\"dusovHistory\", history);\nmsg.payload = { action: \"increment\", counter: counter, lastTimes: history };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
