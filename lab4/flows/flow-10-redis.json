      "parameters": {
        "jsCode": "// В Redis-ноде n8n нет операции Exists, поэтому проверяем через KEYS:\n// Keys возвращает { keys: [...] } — список найденных ключей; пустой список = ключа нет\nconst found = $input.all().flatMap(item => Array.isArray(item.json.keys) ? item.json.keys : Object.keys(item.json));\nconst exists = found.includes('dusov');\nreturn [{\n  json: {\n    key: 'dusov',\n    exists,\n    message: exists ? 'Ключ всё ещё существует' : 'Ключ удалён — его больше нет в Redis',\n  },\n}];"
      },
